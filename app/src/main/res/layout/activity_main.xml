<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- ========== TOP HEADER BAR ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AMIGO Feasibility Demo"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Native Android Proximity &amp; Approach Engine"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- State Badge -->
            <TextView
                android:id="@+id/tvStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/abc_popup_background_mtrl_mult"
                android:backgroundTint="@color/state_gray_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="IDLE"
                android:textColor="@color/state_gray"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Battery Info -->
            <TextView
                android:id="@+id/tvBatteryInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="🔋 --%"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Container for all content cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp">

            <!-- ========== PERMISSION WARNING BANNER (Hidden when all granted) ========== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermissionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/state_amber_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/state_amber"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPermissionWarningTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Background Permission Needed"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPermissionWarningDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set Location to 'Allow all the time' so Android can wake the app when screen is locked."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFixPermission"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/state_amber"
                        android:text="Fix Now"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== HOW TO DEMO (COLLAPSIBLE CARD) ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:id="@+id/headerDemoGuide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💡 HOW TO RUN THIS TEST DEMO"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvToggleGuide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hide ▲"
                            android:textColor="@color/accent"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Collapsible Instruction Content -->
                    <LinearLayout
                        android:id="@+id/layoutGuideContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="3dp"
                            android:text="1️⃣ Set Target: Tap '📍 Here' to make your current spot the reminder target, OR tap '🚶 Place 60m Ahead'.\n2️⃣ Start Test: Tap ▶ START MONITORING below. Turn off / lock the phone.\n3️⃣ Walk Test: Walk away past 60m, then walk toward the target. When approaching within 40m, your phone will ring and show the Opportunity notification!"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <!-- Scenario Selector Pills -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Select Test Case to Log:"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnScenarioPositive"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="3dp"
                                android:layout_weight="1"
                                android:backgroundTint="@color/accent"
                                android:paddingHorizontal="2dp"
                                android:text="✓ Positive Approach"
                                android:textColor="@color/text_white"
                                android:textSize="10sp"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnScenarioNegativeA"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="2dp"
                                android:layout_weight="1"
                                android:paddingHorizontal="2dp"
                                android:text="Neg A (Stationary)"
                                android:textColor="@color/text_primary"
                                android:textSize="10sp"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnScenarioNegativeB"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="3dp"
                                android:layout_weight="1"
                                android:paddingHorizontal="2dp"
                                android:text="Neg B (Outside 40m)"
                                android:textColor="@color/text_primary"
                                android:textSize="10sp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 1. LIVE DISTANCE CARD ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISTANCE TO TARGET"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Big Distance Display -->
                    <TextView
                        android:id="@+id/tvDistanceValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="-- m"
                        android:textColor="@color/text_primary"
                        android:textSize="46sp"
                        android:textStyle="bold" />

                    <!-- Status Description -->
                    <TextView
                        android:id="@+id/tvDistanceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@color/state_gray_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Set target below to begin"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Progress bar to proximity threshold -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Target (0m)"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp" />

                        <ProgressBar
                            android:id="@+id/progressDistance"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/state_green" />

                        <TextView
                            android:id="@+id/tvFenceIndicatorLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fence (50m)"
                            android:textColor="@color/state_blue"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 2. TARGET LOCATION SETUP CARD ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 TARGET REMINDER LOCATION"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- One-Touch Quick Target Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Get Current GPS -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuickMyGps"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="4dp"
                            android:text="📍 Here (0m)"
                            android:textColor="@color/accent"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <!-- Target +60m Ahead -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuick50mAhead"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1.2"
                            android:paddingHorizontal="4dp"
                            android:text="🚶 60m Ahead"
                            android:textColor="@color/state_green"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />

                        <!-- Target +100m Ahead -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuick100mAhead"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_weight="1.2"
                            android:paddingHorizontal="4dp"
                            android:text="🚶 100m Ahead"
                            android:textColor="@color/state_green"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <!-- Latitude & Longitude Inputs (Collapsible / Advanced) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="Latitude"
                            app:boxBackgroundColor="@color/input_bg"
                            app:boxStrokeColor="@color/accent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTargetLat"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal|numberSigned"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:hint="Longitude"
                            app:boxBackgroundColor="@color/input_bg"
                            app:boxStrokeColor="@color/accent">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTargetLng"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal|numberSigned"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Apply Target Button & Arm Toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Arm toggle -->
                        <RadioGroup
                            android:id="@+id/rgArmRadius"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbArm50"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="50m Arm"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <RadioButton
                                android:id="@+id/rbArm150"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="150m Arm"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />
                        </RadioGroup>

                        <!-- Save Target Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveTarget"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/accent"
                            android:text="💾 Save"
                            android:textColor="@color/text_white"
                            android:textSize="11sp"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========== 3. MAIN MONITORING BUTTON ========== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleArm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/state_green"
                android:text="▶ START MONITORING (ARM GEOFENCE)"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="3dp" />

            <!-- ========== 4. QUICK ACTIONS ROW ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTriggerBurstTest"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="⚡ 60s Burst"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportLogs"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="📤 Export"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNote"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="📝 Note"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPermissions"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="4dp"
                    android:text="⚙️ Perms"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- ========== 5. LIVE EVENT LOG FEED ========== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/log_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="LIVE TELEMETRY LOG"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLogCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 events"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Scrollable Log Box -->
                    <ScrollView
                        android:id="@+id/scrollLogs"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="6dp"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tvLogs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="3dp"
                            android:text="[READY] Ready. Set target and tap START."
                            android:textColor="@color/log_text"
                            android:textSize="11sp" />
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
